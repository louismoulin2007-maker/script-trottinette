# Copie ce fichier en ".env" et complète-le

# Ta clé API Anthropic (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Taille du modèle Whisper : tiny, base, small, medium, large-v3
# "small" = bon compromis vitesse/précision sur CPU. "medium" = plus précis mais plus lent.
WHISPER_MODEL=small

# Modèle Claude utilisé pour la traduction/adaptation
ANTHROPIC_MODEL=claude-sonnet-5
